---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import { site } from "@/config/site";

const formOpen = site.flags.waitlistFormEnabled;

const included = [
  { title: "The Windows app", body: "Early builds of NARI Studio for Windows, with every current authoring, quiz and publishing feature." },
  { title: "A direct line to the team", body: "Tell us what works, what doesn't and what your courses need next." },
  { title: "Influence on the roadmap", body: "Your feedback shapes priorities such as macOS, xAPI/cmi5 and narration." },
];

const roles = [
  "Instructional designer",
  "E-learning developer",
  "L&D / training team",
  "Educator or institution",
  "Freelancer / independent creator",
  "Other",
];
---
<BaseLayout
  title="Join early access"
  description="Join the NARI Studio early access programme: early Windows builds of the desktop e-learning authoring tool and a direct line to the team."
>
  <section class="pb-24 pt-14 sm:pt-20">
    <div class="container-site grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="eyebrow mb-4">Early access</p>
        <h1 class="text-[clamp(2.25rem,1.6rem+2.6vw,3.5rem)] leading-[1.06] tracking-[-0.035em]">Be among the first to build with NARI Studio.</h1>
        <p class="mt-6 text-lead text-ink-2">
          NARI Studio is in its final stage of development. We're opening it to a small group of instructional designers, training teams and course creators before the public release.
        </p>
        <ul class="mt-10 space-y-7">
          {included.map((item) => (
            <li class="border-l-2 border-accent pl-5">
              <h2 class="text-h3">{item.title}</h2>
              <p class="mt-1 text-ink-2">{item.body}</p>
            </li>
          ))}
        </ul>
        <p class="mt-10 text-sm text-muted">Windows first. macOS is planned.</p>
      </div>

      <div class="lg:col-span-6">
        <div class="rounded-[20px] border border-line bg-surface p-6 sm:p-8">
          <div class="flex items-start justify-between gap-4">
            <h2 class="text-h3">Request early access</h2>
            {!formOpen && (
              <span class="inline-flex h-6 shrink-0 items-center rounded-full bg-amber-soft px-2.5 text-xs font-semibold text-amber">Opening soon</span>
            )}
          </div>
          {!formOpen && (
            <p id="form-status" class="mt-3 rounded-[var(--radius-control)] bg-sunken p-3 text-sm text-ink-2" role="status">
              Sign-ups aren't open yet. This form will start accepting requests when the early access programme opens.
            </p>
          )}

          <form class="mt-6" method="post" action="/api/waitlist" aria-describedby={formOpen ? undefined : "form-status"} novalidate={!formOpen}>
            <fieldset disabled={!formOpen} class="space-y-5 disabled:opacity-60">
              <legend class="sr-only">Your details</legend>
              <div>
                <label for="name" class="block text-sm font-semibold">Name</label>
                <input id="name" name="name" type="text" autocomplete="name" required class="mt-2 h-11 w-full rounded-[var(--radius-control)] border border-line-strong bg-paper px-3.5 text-[0.9375rem] text-ink placeholder:text-muted disabled:cursor-not-allowed" />
              </div>
              <div>
                <label for="email" class="block text-sm font-semibold">Work email</label>
                <input id="email" name="email" type="email" autocomplete="email" required class="mt-2 h-11 w-full rounded-[var(--radius-control)] border border-line-strong bg-paper px-3.5 text-[0.9375rem] text-ink disabled:cursor-not-allowed" />
              </div>
              <div>
                <label for="role" class="block text-sm font-semibold">What describes you best?</label>
                <select id="role" name="role" class="mt-2 h-11 w-full rounded-[var(--radius-control)] border border-line-strong bg-paper px-3 text-[0.9375rem] text-ink disabled:cursor-not-allowed">
                  <option value="">Choose one</option>
                  {roles.map((role) => <option>{role}</option>)}
                </select>
              </div>
              <div>
                <label for="use" class="block text-sm font-semibold">What would you like to build? <span class="font-normal text-muted">(optional)</span></label>
                <textarea id="use" name="use" rows="3" class="mt-2 w-full rounded-[var(--radius-control)] border border-line-strong bg-paper px-3.5 py-2.5 text-[0.9375rem] text-ink disabled:cursor-not-allowed"></textarea>
              </div>
              <div class="flex gap-3">
                <input id="consent" name="consent" type="checkbox" required class="mt-1 size-4 accent-[var(--nari-accent)]" />
                <label for="consent" class="text-sm text-ink-2">I agree to be contacted about NARI Studio early access. A privacy notice will be published before sign-ups open.</label>
              </div>
              <Button type="submit" size="lg" class="w-full" disabled={!formOpen} cta="early-access-submit">
                {formOpen ? "Request early access" : "Sign-ups opening soon"}
              </Button>
            </fieldset>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
