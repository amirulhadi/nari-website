---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/ui/PageHero.astro";
import CtaBand from "@/components/ui/CtaBand.astro";
import Button from "@/components/ui/Button.astro";
import { solutions, getSolution } from "@/config/solutions";
import { getDemo } from "@/config/showcase";

export function getStaticPaths() {
  return solutions.map((solution) => ({ params: { slug: solution.slug } }));
}

const solution = getSolution(Astro.params.slug!)!;
const demo = getDemo(solution.demo);
const others = solutions.filter((s) => s.slug !== solution.slug);
---
<BaseLayout title={solution.seoTitle} description={solution.metaDescription}>
  <PageHero eyebrow="Solutions" title={solution.title} intro={`For ${solution.audience}.`} />

  <section class="border-t border-line py-16 lg:py-24" aria-labelledby="challenge-title">
    <div class="container-site grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow mb-4">The challenge</p>
        <h2 id="challenge-title" class="text-h2">{solution.challenge.heading}</h2>
      </div>
      <div class="space-y-5 text-lead text-ink-2 lg:col-span-7">
        {solution.challenge.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="bg-surface py-16 lg:py-24" aria-labelledby="helps-title">
    <div class="container-site">
      <p class="eyebrow mb-4">How NARI Studio helps</p>
      <h2 id="helps-title" class="text-h2 max-w-[40rem]">What you can do with it.</h2>
      <div class="mt-12 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line sm:grid-cols-2">
        {solution.helps.map((item) => (
          <div class="bg-surface p-7">
            <h3 class="text-h3">{item.title}</h3>
            <p class="mt-2 text-ink-2">{item.body}</p>
          </div>
        ))}
      </div>
      {solution.note && <p class="mt-6 max-w-[48rem] text-sm text-muted">{solution.note}</p>}
    </div>
  </section>

  <section class="py-16 lg:py-24" aria-labelledby="start-title">
    <div class="container-site grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="eyebrow mb-4">Where to start</p>
        <h2 id="start-title" class="text-h2">Start from "{solution.starter.name}".</h2>
        <p class="mt-5 text-lead text-ink-2">{solution.starter.body}</p>
      </div>
      {demo && (
        <div class="rounded-[var(--radius-card)] border border-line bg-surface p-7 lg:col-span-6">
          <p class="text-sm font-semibold text-accent">Related example</p>
          <h3 class="mt-3 text-h3">{demo.title}</h3>
          <p class="mt-2 text-ink-2">{demo.summary}</p>
          <Button href={`/showcase/${demo.slug}/`} variant="secondary" class="mt-6" cta="solution-demo">Try the example</Button>
        </div>
      )}
    </div>
  </section>

  <section class="border-t border-line py-14" aria-labelledby="more-title">
    <div class="container-site">
      <h2 id="more-title" class="text-sm font-semibold text-muted">More solutions</h2>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        {others.map((s) => <li><a href={`/solutions/${s.slug}/`} class="font-medium text-ink-2 underline decoration-line-strong underline-offset-4 hover:text-ink">{s.label}</a></li>)}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
