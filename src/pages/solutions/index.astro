---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/ui/PageHero.astro";
import CtaBand from "@/components/ui/CtaBand.astro";
import { solutions } from "@/config/solutions";
---
<BaseLayout
  title="E-learning solutions for teams and educators"
  description="How teams use NARI Studio for corporate training, onboarding, compliance training, education and freelance course creation."
>
  <PageHero
    eyebrow="Solutions"
    title="One authoring tool, many kinds of learning."
    intro="From onboarding to assessed compliance training, here is how NARI Studio's capabilities map to common training needs."
  />
  <section class="pb-24 lg:pb-32">
    <div class="container-site grid gap-6 md:grid-cols-2">
      {solutions.map((solution) => (
        <a href={`/solutions/${solution.slug}/`} class="group flex flex-col rounded-[var(--radius-card)] border border-line bg-surface p-7 transition-colors hover:border-ink/40" data-reveal>
          <p class="text-sm font-semibold text-accent">{solution.label}</p>
          <h2 class="mt-3 text-h3">{solution.title}</h2>
          <p class="mt-2 text-ink-2">{solution.summary}</p>
          <p class="mt-auto pt-6 text-sm font-semibold text-ink">Read more <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-0.5">→</span></p>
        </a>
      ))}
    </div>
  </section>
  <CtaBand />
</BaseLayout>
