---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import CtaBand from "@/components/ui/CtaBand.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Logo from "@/components/brand/Logo.astro";
import { getProduct, primaryCta, site } from "@/config/site";

const cta = primaryCta();
const studio = getProduct("studio");
const campus = getProduct("campus");

const flow = [
  {
    n: "01",
    verb: "Create",
    where: "In NARI Studio",
    body: "Build slides, quizzes and branching on your desktop, then export a SCORM 1.2, SCORM 2004 or HTML5 package.",
  },
  {
    n: "02",
    verb: "Deliver",
    where: "In NARI Campus",
    body: "Upload the SCORM package and publish it as a course version. Anyone you share it with can open it in a browser.",
  },
  {
    n: "03",
    verb: "Learn",
    where: "Anywhere",
    body: "Learners play the course in the browser and pick up where they left off. Public courses need no login.",
  },
];

const cards = [
  {
    product: studio,
    id: "studio",
    body: "Design slides, add video, quizzes, drag-and-drop and branching, and preview the course exactly as learners will see it. Then export SCORM 1.2, SCORM 2004 or HTML5. NARI Studio runs on Windows, works offline and keeps your files on your own computer. The beta is open to testers.",
    label: "Learn more about NARI Studio",
  },
  {
    product: campus,
    id: "campus",
    body: "Upload a SCORM package from NARI Studio, publish it, and let learners play it in the browser. NARI Campus records completion, score and where each learner stopped, and keeps every attempt. It is an early demo, and billing in it is simulated.",
    label: "Learn more about NARI Campus",
  },
];
---
<BaseLayout
  description="NARI makes learning software that works as one system: NARI Studio to author interactive courses, NARI Campus to publish, deliver and track them."
>
  <!-- Hero -->
  <section class="overflow-hidden pb-16 pt-14 sm:pt-20 lg:pb-24">
    <div class="container-site">
      <div class="max-w-[52rem]">
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-sm font-medium text-ink-2">
          <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          {site.productStage}
        </p>
        <h1 class="text-display">Learning software that works as one system.</h1>
        <p class="mt-6 max-w-[40rem] text-lead text-ink-2">
          NARI Studio is where you author interactive courses on your desktop. NARI Campus is where you publish them, deliver them and see who finished. Courses move from one to the other as standard SCORM packages.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href={cta.href} size="lg" cta="hero-primary">{cta.label}</Button>
          <Button href="#products" variant="secondary" size="lg" cta="hero-secondary">See the products</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Create, deliver, learn -->
  <section class="border-t border-line bg-surface py-20 lg:py-24" aria-labelledby="flow-title">
    <div class="container-site">
      <SectionHeader id="flow-title" eyebrow="How it fits together" title="Create it, deliver it, learn from it." />
      <ol class="mt-14 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line md:grid-cols-3">
        {flow.map((step) => (
          <li class="bg-surface p-7" data-reveal>
            <span class="font-mono text-sm text-accent">{step.n}</span>
            <h3 class="mt-4 text-h3">{step.verb}</h3>
            <p class="mt-1 text-sm font-semibold text-muted">{step.where}</p>
            <p class="mt-3 text-[0.9875rem] text-ink-2">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Products -->
  <section id="products" class="py-20 lg:py-28" aria-labelledby="products-title">
    <div class="container-site">
      <SectionHeader id="products-title" eyebrow="Products" title="Two products, one identity." intro="Each product works on its own. Together they take a course from the first slide to the learner's final score." />
      <div class="mt-14 grid gap-6 lg:grid-cols-2">
        {cards.map((card) => (
          <article class="flex flex-col rounded-[var(--radius-card)] border border-line bg-surface p-7 sm:p-8" data-reveal aria-labelledby={`${card.id}-card-title`}>
            <div class="flex items-start justify-between gap-4">
              <Logo product={card.id as "studio" | "campus"} size="md" />
              <span class="inline-flex h-6 shrink-0 items-center rounded-full bg-accent-soft px-2.5 text-xs font-semibold text-accent">{card.product.status}</span>
            </div>
            <h3 id={`${card.id}-card-title`} class="mt-6 text-h3">{card.product.descriptor}</h3>
            <p class="mt-3 text-ink-2">{card.body}</p>
            <p class="mt-auto pt-7">
              <a href={card.product.path} class="text-sm font-semibold text-ink underline decoration-line-strong underline-offset-4 hover:decoration-ink" aria-label={card.label}>Learn more <span aria-hidden="true">→</span></a>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Join early access to NARI."
    body="We are opening NARI Studio to a small group of course creators first, and NARI Campus is available as an early demo. Join early access to be among them."
  />
</BaseLayout>
