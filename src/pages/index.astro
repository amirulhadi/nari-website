---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import StatusTag from "@/components/ui/StatusTag.astro";
import ProductFrame from "@/components/ui/ProductFrame.astro";
import { featureGroups } from "@/config/features";
import { plans, pricing } from "@/config/pricing";
import { primaryCta, site } from "@/config/site";

import editorQuestion from "@/assets/screenshots/editor-question.png";
import editorBranching from "@/assets/screenshots/editor-branching.png";
import editorResults from "@/assets/screenshots/editor-results.png";
import editorDragdrop from "@/assets/screenshots/editor-dragdrop.png";
import templatePicker from "@/assets/screenshots/template-picker.png";
import learnerQuestion from "@/assets/screenshots/learner-question.png";
import learnerDragdrop from "@/assets/screenshots/learner-dragdrop.png";
import manifest from "@/assets/screenshots/manifest.json";

const cta = primaryCta();
const appVersion = manifest.appVersion;

const benefits = [
  {
    title: "One focused workspace",
    body: "Slides, timeline, media, quizzes and publishing in a single desktop app. No plug-ins and no add-ons to juggle.",
  },
  {
    title: "Real interactivity",
    body: "Drag-and-drop, branching by score, question pools and results with review: the building blocks of courses people actually engage with.",
  },
  {
    title: "Ready for your LMS",
    body: "Export SCORM 1.2 or SCORM 2004 with completion rules, pass marks and resume, or publish a standalone HTML5 course.",
  },
];

const steps = [
  { n: "01", title: "Start", body: "Pick a starter course or import a PowerPoint or Captivate file." },
  { n: "02", title: "Build", body: "Design slides, time objects on the timeline and add video, audio and captions." },
  { n: "03", title: "Make it interactive", body: "Add questions, drag-and-drop, branching and conditional content." },
  { n: "04", title: "Preview & publish", body: "Play it exactly as learners will, then export for your LMS." },
];

const highlights = [
  {
    id: "assessment",
    eyebrow: "Quizzes & assessment",
    title: "Assessments that are fair, varied and properly tracked",
    body: "Build multiple-choice, true/false and drag-and-drop questions. Draw a different set of questions for every learner from a pool, then show a results slide with pass/fail, a review of answers and a try-again option.",
    points: ["Question pools with random selection and order", "Attempts, feedback and a pass mark", "Results, review mode and try again"],
    image: editorResults,
    alt: "NARI Studio editor showing the Results slide of the Knowledge quiz template, with a score card and Review answers and Try again buttons",
    caption: "Results slide in the Knowledge quiz starter course.",
  },
  {
    id: "branching",
    eyebrow: "Branching & logic",
    title: "Scenarios that respond to every decision",
    body: "Send learners down different paths by their score, a variable or the result of a question. Show content only when a condition holds, and drop live values such as the learner's score straight into text.",
    points: ["\"If… go to slide\" branching", "Conditional show and hide", "Live text with {{score}} and variables"],
    image: editorBranching,
    alt: "NARI Studio editor showing a decision slide with three choice buttons in the Branching scenario template",
    caption: "Decision slide in the Branching scenario starter course.",
  },
  {
    id: "dragdrop",
    eyebrow: "Drag and drop",
    title: "Hands-on activities without code",
    body: "Create matching and sorting exercises with drop zones, or turn any objects on your slide into draggable items. Scoring, attempts and feedback work the same way as every other question.",
    points: ["Dedicated drag-and-drop questions", "Use any slide object as an item or target", "Recorded as an interaction in SCORM"],
    image: editorDragdrop,
    alt: "NARI Studio editor showing a drag-and-drop exercise with two zones and two items",
    caption: "Drag-and-drop practice starter course.",
  },
  {
    id: "templates",
    eyebrow: "Starter courses",
    title: "Start from a course that already works",
    body: "Five starter courses give you a working structure on day one, from a scored knowledge quiz to a branching scenario. Every template is fully editable and passes the built-in checks.",
    points: ["Knowledge quiz, lesson, branching scenario, drag-and-drop practice", "Eleven slide layouts", "Four colour themes"],
    image: templatePicker,
    alt: "The Start a new course dialog in NARI Studio listing five starter courses",
    caption: "Choosing a starter course.",
  },
];

const audiences = [
  {
    title: "Instructional designers & e-learning developers",
    body: "A dedicated authoring tool with a real timeline, interactions and assessment, without the weight of a large suite.",
  },
  {
    title: "Corporate L&D and training teams",
    body: "Onboarding, compliance and product training that report completion and scores to your LMS.",
  },
  {
    title: "Educators & institutions",
    body: "Interactive lessons and knowledge checks with accessibility checks built into the workflow.",
  },
  {
    title: "Freelancers & independent creators",
    body: "Build client courses quickly from templates and deliver standard SCORM packages any LMS can import.",
  },
];

const publishingPoints = [
  { title: "SCORM 1.2 & SCORM 2004 (4th edition)", body: "Completion by last slide, all slides, pass mark or exit; pass/fail and score; resume where the learner left off." },
  { title: "HTML5 package", body: "A standalone course that plays in any modern browser, for intranets or your own website." },
  { title: "Check before you export", body: "Broken links, missing media, quiz problems and accessibility hints are flagged with a link to the slide." },
  { title: "Accessible player", body: "Keyboard operation, alt text and screen-reader announcements in every exported course." },
];

const totalAvailable = featureGroups.reduce((sum, group) => sum + group.features.filter((f) => f.status === "available").length, 0);

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: site.brand,
  applicationCategory: "EducationalApplication",
  operatingSystem: "Windows",
  description: site.description,
  softwareVersion: appVersion,
};
---
<BaseLayout
  description="NARI Studio is a desktop e-learning authoring tool. Build interactive courses with quizzes, branching, drag-and-drop and video, then publish SCORM 1.2, SCORM 2004 or HTML5 for any LMS."
  structuredData={[softwareJsonLd]}
>
  <!-- Hero -->
  <section class="overflow-hidden pb-20 pt-14 sm:pt-20 lg:pb-28">
    <div class="container-site">
      <div class="max-w-[52rem]">
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-sm font-medium text-ink-2">
          <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          {site.productStage} · Windows · v{appVersion}
        </p>
        <h1 class="text-display">Build interactive courses. Publish to your LMS.</h1>
        <p class="mt-6 max-w-[40rem] text-lead text-ink-2">
          NARI Studio is a desktop authoring tool for instructional designers and training teams. Design slides, add video, quizzes and branching, then export SCORM or HTML5, all offline, with your files on your own computer.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href={cta.href} size="lg" cta="hero-primary">{cta.label}</Button>
          <Button href="#features" variant="secondary" size="lg" cta="hero-secondary">Explore features</Button>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted" aria-label="Key facts">
          <li>Works offline</li>
          <li>SCORM 1.2 &amp; 2004</li>
          <li>PowerPoint &amp; Captivate import</li>
          <li>No usage tracking</li>
        </ul>
      </div>

      <ProductFrame
        class="mt-14 lg:mt-20"
        src={editorQuestion}
        alt="The NARI Studio editor: slide list on the left, a multiple-choice question selected on the canvas, the timeline below and question properties on the right"
        title="NARI Studio — Knowledge quiz"
        caption={`NARI Studio v${appVersion}, editing a pooled question in the Knowledge quiz starter course. Real screenshot.`}
        priority
      />
    </div>
  </section>

  <!-- Benefits -->
  <section class="border-t border-line py-20 lg:py-28" aria-labelledby="benefits-title">
    <div class="container-site">
      <SectionHeader id="benefits-title" eyebrow="Why NARI Studio" title="Professional courses, without the heavyweight." />
      <div class="mt-14 grid gap-10 md:grid-cols-3">
        {benefits.map((item) => (
          <div data-reveal>
            <h3 class="text-h3">{item.title}</h3>
            <p class="mt-3 text-ink-2">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Workflow -->
  <section class="bg-surface py-20 lg:py-28" aria-labelledby="workflow-title">
    <div class="container-site">
      <SectionHeader id="workflow-title" eyebrow="How it works" title="From first slide to LMS in four steps." />
      <ol class="mt-14 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((step) => (
          <li class="bg-surface p-7" data-reveal>
            <span class="font-mono text-sm text-accent">{step.n}</span>
            <h3 class="mt-4 text-h3">{step.title}</h3>
            <p class="mt-2 text-[0.9875rem] text-ink-2">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Feature highlights -->
  <section id="features" class="py-20 lg:py-28" aria-labelledby="features-title">
    <div class="container-site">
      <SectionHeader id="features-title" eyebrow="Features" title="Everything a course needs, built in." intro="The capabilities below are in the current release. Screenshots are taken from the app itself." />
      <div class="mt-16 space-y-24 lg:space-y-32">
        {highlights.map((item, index) => (
          <article id={item.id} class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14" data-reveal>
            <div class:list={["lg:col-span-5", index % 2 === 1 && "lg:order-2"]}>
              <p class="eyebrow mb-4">{item.eyebrow}</p>
              <h3 class="text-[1.75rem] leading-tight tracking-[-0.025em] sm:text-[2rem]">{item.title}</h3>
              <p class="mt-4 text-ink-2">{item.body}</p>
              <ul class="mt-6 space-y-2.5">
                {item.points.map((point) => (
                  <li class="flex gap-3 text-[0.9875rem] text-ink">
                    <svg class="mt-1.5 shrink-0 text-accent" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" /></svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class:list={["lg:col-span-7", index % 2 === 1 && "lg:order-1"]}>
              <ProductFrame src={item.image} alt={item.alt} caption={item.caption} sizes="(min-width: 1200px) 660px, (min-width: 1024px) 56vw, 100vw" />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Capability overview -->
  <section class="border-t border-line bg-surface py-20 lg:py-28" aria-labelledby="capabilities-title">
    <div class="container-site">
      <SectionHeader
        id="capabilities-title"
        eyebrow="Capabilities"
        title="What's in NARI Studio today."
        intro={`${totalAvailable} capabilities available now, and what we're working on next, labelled honestly.`}
      />
      <div class="mt-14 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {featureGroups.map((group) => (
          <div class="bg-surface p-7">
            <h3 class="text-h3">{group.title}</h3>
            <p class="mt-2 text-sm text-ink-2">{group.summary}</p>
            <ul class="mt-5 space-y-2.5">
              {group.features.map((feature) => (
                <li class="flex items-start justify-between gap-3 text-sm">
                  <span class:list={[feature.status === "available" ? "text-ink" : "text-muted"]}>{feature.title}</span>
                  {feature.status !== "available" && <StatusTag status={feature.status} class="shrink-0" />}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Publishing -->
  <section id="publishing" class="bg-product py-20 text-[#eef1f5] lg:py-28" aria-labelledby="publishing-title">
    <div class="container-site grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow mb-4 !text-[#2dd4bf]">Publishing</p>
        <h2 id="publishing-title" class="text-h2 !text-white">Publish once. Track it in your LMS.</h2>
        <p class="mt-5 text-lead text-[#b7c0cc]">
          Export standards-based packages your learning management system can import, with completion, scores and answers reported back.
        </p>
        <p class="mt-6 rounded-[var(--radius-card)] border border-white/10 p-4 text-sm text-[#8a94a3]">
          SCORM packages are tested against simulated LMS environments. Verification in SCORM Cloud and common LMSs is in progress during early access.
        </p>
      </div>
      <div class="grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-white/10 bg-white/10 sm:grid-cols-2 lg:col-span-7">
        {publishingPoints.map((point) => (
          <div class="bg-product p-7" data-reveal>
            <h3 class="text-h3 !text-white">{point.title}</h3>
            <p class="mt-2 text-[0.9375rem] text-[#b7c0cc]">{point.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Learner view / examples -->
  <section id="examples" class="py-20 lg:py-28" aria-labelledby="examples-title">
    <div class="container-site">
      <SectionHeader
        id="examples-title"
        eyebrow="What learners see"
        title="Preview it the way learners will see it."
        intro="Preview and exported courses are built from the same course document, so you can test before you publish. These are starter-course slides as they appear to a learner, before any content is added."
      />
      <div class="mt-14 grid gap-8 md:grid-cols-2">
        <ProductFrame src={learnerQuestion} alt="Learner view of a multiple-choice question with three answer options and a Submit button" title="Preview — Question 1" caption="Pooled multiple-choice question (Knowledge quiz template)." sizes="(min-width: 1200px) 560px, (min-width: 768px) 50vw, 100vw" />
        <ProductFrame src={learnerDragdrop} alt="Learner view of a drag-and-drop exercise with two drop zones, two items and Submit and Reset buttons" title="Preview — Match the items" caption="Drag-and-drop exercise (Drag and drop practice template)." sizes="(min-width: 1200px) 560px, (min-width: 768px) 50vw, 100vw" />
      </div>
      <p class="mt-8 text-ink-2">
        Want to try one? <a href="/showcase/" class="font-semibold text-ink underline decoration-line-strong underline-offset-4 hover:decoration-ink">Play the example courses</a>, real exports from NARI Studio.
      </p>
    </div>
  </section>

  <!-- Migration -->
  <section class="border-t border-line py-20 lg:py-24" aria-labelledby="migration-title">
    <div class="container-site grid items-start gap-10 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="eyebrow mb-4">Migration</p>
        <h2 id="migration-title" class="text-h2">Bring your existing content with you.</h2>
      </div>
      <div class="lg:col-span-6">
        <p class="text-lead text-ink-2">
          Import a PowerPoint (.pptx) or Captivate (.cpt, .cptx) file as a starting point. NARI Studio rebuilds the slides, text, shapes and media it can, then opens an Import report that lists what converted, what needs your attention and where.
        </p>
        <p class="mt-4 text-sm text-muted">
          Imports are best-effort: animations, speaker notes and the original interactions and quizzes are not converted. Recreate those with NARI Studio's own tools.
        </p>
      </div>
    </div>
  </section>

  <!-- Audiences -->
  <section id="audiences" class="bg-surface py-20 lg:py-28" aria-labelledby="audiences-title">
    <div class="container-site">
      <SectionHeader id="audiences-title" eyebrow="Who it's for" title="Made for the people who build learning." />
      <div class="mt-14 grid gap-6 sm:grid-cols-2">
        {audiences.map((item) => (
          <div class="rounded-[var(--radius-card)] border border-line bg-paper p-7" data-reveal>
            <h3 class="text-h3">{item.title}</h3>
            <p class="mt-2 text-ink-2">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Plans -->
  <section id="plans" class="py-20 lg:py-28" aria-labelledby="plans-title">
    <div class="container-site">
      <SectionHeader
        id="plans-title"
        eyebrow="Plans"
        title="Start free. Upgrade when you publish professionally."
        intro="A complete Free plan, with paid plans for commercial work and teams. Pricing will be announced at launch."
      />
      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {plans.map((plan) => (
          <div class:list={["flex flex-col rounded-[var(--radius-card)] border bg-surface p-6", plan.featured ? "border-ink" : "border-line"]}>
            <h3 class="text-h3">{plan.name}</h3>
            <p class="mt-1 min-h-[2.75rem] text-sm text-muted">{plan.audience}</p>
            <p class="mt-4 text-lg font-bold tracking-[-0.01em]">
              {plan.monthly === 0 ? "No charge" : plan.unit === "custom" ? "Custom" : "Announced at launch"}
            </p>
            <ul class="mt-5 space-y-2 text-sm text-ink-2">
              {plan.highlights.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-6 text-sm text-muted">
        Plan contents are a proposal and may change before launch.{pricing.trialDays ? ` Paid plans include a ${pricing.trialDays}-day free trial.` : ""}
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="pb-24 lg:pb-32" aria-labelledby="cta-title">
    <div class="container-site">
      <div class="rounded-[24px] bg-ink px-6 py-16 text-center sm:px-12 lg:py-20">
        <h2 id="cta-title" class="text-h2 !text-paper">Build your next course with NARI Studio.</h2>
        <p class="mx-auto mt-5 max-w-xl text-lead !text-paper/70">
          We're opening NARI Studio to a small group of course creators first. Join early access to be among them.
        </p>
        <div class="mt-9 flex justify-center">
          <a href={cta.href} data-cta="footer-cta" class="inline-flex h-12 items-center justify-center rounded-[var(--radius-control)] bg-paper px-6 font-semibold text-ink transition-colors hover:bg-paper/90">{cta.label}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
