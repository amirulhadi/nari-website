---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/ui/PageHero.astro";
import CtaBand from "@/components/ui/CtaBand.astro";
import { demos, notShown } from "@/config/showcase";
import manifest from "@/assets/screenshots/manifest.json";
---
<BaseLayout
  product="studio"
  breadcrumbs={[{ name: "NARI Studio", path: "/studio/" }, { name: "Showcase", path: "/studio/showcase/" }]}
  title="Showcase: example e-learning courses"
  description="Play real example courses made with NARI Studio: a scored quiz with question pools, a branching scenario, an onboarding lesson and a drag-and-drop activity."
>
  <PageHero
    eyebrow="Showcase"
    title="Play real courses made with NARI Studio."
    intro={`These examples are real HTML5 exports from NARI Studio v${manifest.appVersion}, built from the app's starter courses with neutral demonstration content. Open one and use it the way a learner would.`}
  />

  <section class="pb-16 lg:pb-24">
    <div class="container-site grid gap-6 md:grid-cols-2">
      {demos.map((demo) => (
        <a href={`/studio/showcase/${demo.slug}/`} class="group flex flex-col rounded-[var(--radius-card)] border border-line bg-surface p-7 transition-colors hover:border-ink/40" data-reveal>
          <p class="text-sm font-semibold text-accent">{demo.kind}</p>
          <h2 class="mt-3 text-h3">{demo.title}</h2>
          <p class="mt-2 text-ink-2">{demo.summary}</p>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="Capabilities shown">
            {demo.uses.map((use) => <li class="rounded-full bg-sunken px-3 py-1 text-xs font-medium text-ink-2">{use}</li>)}
          </ul>
          <p class="mt-auto pt-6 text-sm font-semibold text-ink">Play the example <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-0.5">→</span></p>
        </a>
      ))}
    </div>
  </section>

  <section class="border-t border-line bg-surface py-16 lg:py-20" aria-labelledby="notshown-title">
    <div class="container-site grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="notshown-title" class="text-h2">What these examples don't show yet.</h2>
      </div>
      <ul class="space-y-4 text-ink-2 lg:col-span-7">
        {notShown.map((item) => <li class="border-l-2 border-line-strong pl-4">{item}</li>)}
      </ul>
    </div>
  </section>

  <div class="pt-20 lg:pt-28"><CtaBand /></div>
</BaseLayout>
