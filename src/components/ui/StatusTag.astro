---
import { STATUS_LABEL, type FeatureStatus } from "@/config/features";
interface Props { status: FeatureStatus; class?: string }
const { status, class: className } = Astro.props;
const styles: Record<FeatureStatus, string> = {
  available: "bg-accent-soft text-accent",
  "in-development": "bg-amber-soft text-amber",
  planned: "border border-line-strong text-muted",
};
---
<span class:list={["inline-flex h-6 items-center rounded-full px-2.5 text-xs font-semibold", styles[status], className]}>
  {STATUS_LABEL[status]}
</span>
