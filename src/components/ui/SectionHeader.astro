---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: "left" | "center";
  id?: string;
  class?: string;
}
const { eyebrow, title, intro, align = "left", id, class: className } = Astro.props;
---
<div class:list={["max-w-[44rem]", align === "center" && "mx-auto text-center", className]}>
  {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
  <h2 id={id} class="text-h2">{title}</h2>
  {intro && <p class="mt-5 text-lead text-ink-2">{intro}</p>}
</div>
