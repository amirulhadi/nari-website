---
import { primaryCta } from "@/config/site";
interface Props {
  title?: string;
  body?: string;
}
const {
  title = "Build your next course with NARI Studio.",
  body = "We're opening NARI Studio to a small group of course creators first. Join early access to be among them.",
} = Astro.props;
const cta = primaryCta();
---
<section class="pb-24 lg:pb-32" aria-labelledby="cta-band-title">
  <div class="container-site">
    <div class="rounded-[24px] border border-[var(--nari-band-border)] bg-[var(--nari-band-bg)] px-6 py-16 text-center sm:px-12 lg:py-20">
      <h2 id="cta-band-title" class="text-h2 !text-[var(--nari-band-fg)]">{title}</h2>
      <p class="mx-auto mt-5 max-w-xl text-lead !text-[var(--nari-band-fg-2)]">{body}</p>
      <div class="mt-9 flex justify-center">
        <a href={cta.href} data-cta="band-cta" class="inline-flex h-12 items-center justify-center rounded-[var(--radius-control)] bg-[var(--nari-band-btn-bg)] px-6 font-semibold text-[var(--nari-band-btn-fg)] transition-opacity hover:opacity-90">{cta.label}</a>
      </div>
    </div>
  </div>
</section>
