---
import Logo from "@/components/brand/Logo.astro";
import { footerNav, resolve } from "@/config/navigation";
import { copyrightHolder, products, site } from "@/config/site";

const columns = footerNav
  .map((column) => ({ title: column.title, links: resolve(column.items) }))
  .filter((column) => column.links.length > 0);
const year = new Date().getFullYear();
// The Beta Edition pages do not mention the disabled import, so their footer leaves out that trademark line.
const inBeta = Astro.url.pathname.startsWith("/studio/beta");
---
<footer class="mt-auto border-t border-line bg-paper">
  <div class="container-site grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
    <div class="max-w-xs">
      <Logo size="sm" />
      <p class="mt-4 text-sm text-ink-2">{site.tagline}</p>
      <ul class="mt-3 space-y-1 text-sm text-muted">
        {products.map((product) => <li>{product.name}: {product.status}</li>)}
      </ul>
    </div>
    {columns.map((column) => (
      <nav aria-label={column.title}>
        <h2 class="text-sm font-semibold text-ink">{column.title}</h2>
        <ul class="mt-4 space-y-2.5">
          {column.links.map((link) => (
            <li><a href={link.href} class="text-sm text-ink-2 transition-colors hover:text-ink">{link.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="border-t border-line">
    <div class="container-site flex flex-col gap-2 py-6 text-xs text-muted lg:flex-row lg:justify-between">
      <p>© {year} {copyrightHolder()}. All rights reserved.</p>
      {inBeta ? (
        <p>PowerPoint is a trademark of Microsoft. NARI is not affiliated with Microsoft.</p>
      ) : (
        <p>PowerPoint is a trademark of Microsoft. Captivate is a trademark of Adobe. NARI is not affiliated with either company.</p>
      )}
    </div>
  </div>
</footer>
