---
import { comparison, plans, type Cell } from "@/config/pricing";
import StatusTag from "@/components/ui/StatusTag.astro";

const isPlanned = (cell: Cell): cell is { planned: string | true } => typeof cell === "object";
---
<div class="overflow-x-auto rounded-[var(--radius-card)] border border-line bg-surface" tabindex="0" role="region" aria-label="Plan comparison table, scrolls horizontally on small screens">
  <table class="w-full min-w-[820px] table-fixed border-collapse text-left text-sm">
    <caption class="sr-only">Comparison of the Free, Pro, Team and Enterprise plans. Items marked Planned are not available yet.</caption>
    <thead>
      <tr class="border-b border-line">
        <th scope="col" class="sticky left-0 z-10 w-[34%] bg-surface px-5 py-4 text-sm font-semibold text-muted"><span class="sr-only">Feature</span></th>
        {plans.map((plan) => (
          <th scope="col" class="px-4 py-4 text-base font-bold text-ink">{plan.name}</th>
        ))}
      </tr>
    </thead>
    {comparison.map((group) => (
      <tbody>
        <tr>
          <th colspan="5" scope="colgroup" class="bg-sunken px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.08em] text-muted">{group.title}</th>
        </tr>
        {group.rows.map((row) => (
          <tr class="border-t border-line align-top">
            <th scope="row" class="sticky left-0 z-10 bg-surface px-5 py-3.5 text-sm font-medium text-ink">
              {row.label}
              {row.note && <span class="mt-1 block text-xs font-normal text-muted">{row.note}</span>}
            </th>
            {row.values.map((cell) => (
              <td class="px-4 py-3.5 text-ink-2">
                {cell === true ? (
                  <>
                    <svg class="text-accent" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" /></svg>
                    <span class="sr-only">Included</span>
                  </>
                ) : cell === false ? (
                  <>
                    <span aria-hidden="true" class="text-line-strong">—</span>
                    <span class="sr-only">Not included</span>
                  </>
                ) : isPlanned(cell) ? (
                  <span class="flex flex-wrap items-center gap-2">
                    {cell.planned !== true && <span>{cell.planned}</span>}
                    <StatusTag status="planned" />
                  </span>
                ) : (
                  <span>{cell}</span>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    ))}
  </table>
</div>
