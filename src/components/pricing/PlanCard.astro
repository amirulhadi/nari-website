---
/**
 * One plan. Monthly and annual price text are both rendered; the billing toggle
 * (public/js/site.js) shows one via the [data-billing] attribute on the nearest
 * [data-billing-root]. Prices come from src/config/pricing.ts.
 */
import Button from "@/components/ui/Button.astro";
import { pricing, type Plan } from "@/config/pricing";
import { primaryCta } from "@/config/site";

interface Props {
  plan: Plan;
  /** Show the highlights list (off for the compact variant). */
  showHighlights?: boolean;
}
const { plan, showHighlights = true } = Astro.props;

const money = (amount: number) =>
  new Intl.NumberFormat("en-US", { style: "currency", currency: pricing.currency, maximumFractionDigits: 2, minimumFractionDigits: Number.isInteger(amount) ? 0 : 2 }).format(amount);
const unitLabel = plan.unit === "seat" ? "per seat / month" : "per month";

type Mode = "monthly" | "annual";
const priceFor = (mode: Mode) => (mode === "monthly" ? plan.monthly : plan.annual);

function headline(mode: Mode) {
  if (plan.unit === "custom") return { main: "Custom", sub: "By agreement" };
  if (plan.monthly === 0) return { main: "No charge", sub: "No billing" };
  const price = priceFor(mode);
  if (price === null) return { main: "Announced at launch", sub: mode === "monthly" ? "Billed monthly" : "Billed annually" };
  return { main: money(price), sub: `${unitLabel}, billed ${mode === "monthly" ? "monthly" : "annually"}` };
}

const cta = plan.cta === "contact-sales" ? { label: "Contact sales", href: "/contact/" } : primaryCta();
const trial = pricing.trialDays && plan.monthly !== 0 && plan.unit !== "custom" ? `Includes a ${pricing.trialDays}-day free trial` : null;
---
<div class:list={["flex flex-col rounded-[var(--radius-card)] border bg-surface p-6", plan.featured ? "border-ink" : "border-line"]} data-plan={plan.id}>
  <div class="flex items-center justify-between gap-3">
    <h3 class="text-h3">{plan.name}</h3>
    {plan.featured && <span class="rounded-full bg-ink px-2.5 py-0.5 text-xs font-semibold text-paper">Recommended</span>}
  </div>
  <p class="mt-1 min-h-[2.75rem] text-sm text-muted">{plan.audience}</p>

  {(["monthly", "annual"] as Mode[]).map((mode) => {
    const h = headline(mode);
    return (
      <div data-when={mode} class="mt-4 min-h-[4rem]">
        <p class="text-lg font-bold tracking-[-0.01em]">{h.main}</p>
        <p class="text-sm text-muted">{h.sub}</p>
      </div>
    );
  })}

  {trial && <p class="mt-2 text-sm font-medium text-accent">{trial}</p>}

  <Button href={cta.href} variant={plan.featured ? "primary" : "secondary"} class="mt-5 w-full" cta={`plan-${plan.id}`}>{cta.label}</Button>

  {showHighlights && (
    <ul class="mt-6 space-y-2 border-t border-line pt-5 text-sm text-ink-2">
      {plan.highlights.map((point) => (
        <li class="flex gap-2.5">
          <svg class="mt-1 shrink-0 text-accent" width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" /></svg>
          <span>{point}</span>
        </li>
      ))}
    </ul>
  )}
</div>
