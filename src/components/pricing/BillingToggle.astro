---
/**
 * Monthly / annual switch. Hidden without JavaScript (the monthly view is shown).
 * Behaviour lives in public/js/site.js; it only flips [data-billing] on the page's
 * [data-billing-root], which CSS uses to show the matching price text.
 */
import { pricing } from "@/config/pricing";
const saving = pricing.annualSavingPercent;
---
<div data-js-only class="inline-flex items-center gap-3" role="group" aria-label="Billing period">
  <div class="inline-flex rounded-full border border-line-strong bg-surface p-1">
    <button type="button" data-billing-set="monthly" aria-pressed="true" class="h-9 rounded-full px-4 text-sm font-semibold transition-colors aria-pressed:bg-ink aria-pressed:text-paper text-ink-2">Monthly</button>
    <button type="button" data-billing-set="annual" aria-pressed="false" class="h-9 rounded-full px-4 text-sm font-semibold transition-colors aria-pressed:bg-ink aria-pressed:text-paper text-ink-2">Annual</button>
  </div>
  {saving ? (
    <span class="text-sm font-semibold text-accent">Save {saving}%</span>
  ) : (
    <span class="text-sm text-muted">Annual savings announced at launch</span>
  )}
</div>
