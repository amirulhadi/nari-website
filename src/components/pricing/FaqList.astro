---
import type { Faq } from "@/config/pricing";
interface Props { items: Faq[] }
const { items } = Astro.props;
---
<div class="divide-y divide-line rounded-[var(--radius-card)] border border-line bg-surface">
  {items.map((item) => (
    <details class="group px-6 py-5">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-base font-semibold text-ink marker:content-none [&::-webkit-details-marker]:hidden">
        <span>{item.question}</span>
        <svg class="mt-1.5 shrink-0 text-muted transition-transform group-open:rotate-45" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 2v12M2 8h12" /></svg>
      </summary>
      <p class="mt-3 max-w-[60ch] text-ink-2">{item.answer}</p>
    </details>
  ))}
</div>
